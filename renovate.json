{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>coo-quack/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The toolchain channel in rust-toolchain.toml (no built-in Renovate manager reads it)",
      "managerFilePatterns": ["/^rust-toolchain\\.toml$/"],
      "matchStrings": ["channel\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker",
      "depNameTemplate": "rust",
      "packageNameTemplate": "rust"
    }
  ],
  "packageRules": [
    {
      "description": "The rust image in the Dockerfile and the pinned toolchain move in one PR",
      "groupName": "Rust toolchain",
      "matchManagers": ["dockerfile", "custom.regex"],
      "matchPackageNames": ["rust"]
    }
  ]
}
