# Rotates the log files of vigilant-heron. SIGUSR1 makes the router reopen its
# log files after the rotation.
/var/log/vigilant-heron/*.log /var/log/vigilant-heron/*.json {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    create 640 vigilant-heron adm
    su vigilant-heron adm
    postrotate
        systemctl kill -s USR1 vigilant-heron.service >/dev/null 2>&1 || true
    endscript
}
